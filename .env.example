PORT=8787
ADMIN_TOKEN=change-me-admin
SESSION_SECRET=change-me-session-secret
# In production use an ABSOLUTE persistent path if you want to override the automatic ~/.xaucloud-apex store.
# DATA_DIR=/persistent/path/xaucloud-apex
XAUCLOUD_BASE_URL=https://xaucloud.io
APEX_BRIDGE_SECRET=replace-with-the-same-secret-configured-on-xaucloud

APEX_PUBLIC_ORIGIN=https://apex.xaucloud.io
# Optional: if omitted, VAPID keys are generated once into persistent DATA_DIR/vapid.json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://apex.xaucloud.io
