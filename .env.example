PORT=8787
# LOCAL DEV ONLY. NODE_ENV=production refuses the published defaults below,
# any ADMIN_TOKEN shorter than 24 characters, any SESSION_SECRET shorter than 32,
# and an http:// XAUCLOUD_BASE_URL. Never print real secret values.
ADMIN_TOKEN=change-me-admin
SESSION_SECRET=change-me-session-secret
# Production systemd unit sets DATA_DIR=/var/lib/xaucloud-apex.
# DATA_DIR=/var/lib/xaucloud-apex
XAUCLOUD_BASE_URL=https://xaucloud.io
APEX_BRIDGE_SECRET=replace-with-the-same-secret-configured-on-xaucloud

APEX_PUBLIC_ORIGIN=https://apex.xaucloud.io
# Optional: if omitted, VAPID keys are generated once into persistent DATA_DIR/vapid.json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://apex.xaucloud.io
